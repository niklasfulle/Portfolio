// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model AboutMe {
  id            String   @id @unique
  textDe          String?
  textEn          String?
  visible       Boolean  @default(false)
  series        Int      @default(0)
}

model Projects {
  id            String   @id @default(cuid()) @unique
  title         String
  descriptionDe   String
  descriptionEn   String
  image         String?
  url           String?
  tags          String
  visible       Boolean  @default(false)
  series        Int      @default(0)
}

model Skills {
  id            String   @id @default(cuid()) @unique
  name          String
  image         String?
  type          String?
  visible       Boolean  @default(false)
  series        Int      @default(0)
}

model Experience {
  id            String   @id @default(cuid()) @unique
  category      String   @default("experience")
  titleDe         String
  titleEn         String
  location      String
  descriptionDe   String
  descriptionEn   String
  icon          String
  date          String
  visible       Boolean  @default(false)
  series        Int      @default(0)
}

model ContactEmail {
  id           String   @id @default(cuid()) @unique
  email        String
}

model GithubStatsSnapshot {
  id        String   @id
  data      Json
  fetchedAt DateTime @default(now()) @updatedAt
}
